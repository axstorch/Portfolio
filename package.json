{
  "name": "akshat-saxena-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && vite",
    "dev:css": "tailwindcss -i tailwind.input.css -o public/styles.css --watch",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:css": "tailwindcss -i tailwind.input.css -o public/styles.css --minify",
    "build:client": "npm run build:css && vite build",
    "build:ssr": "vite build --ssr prerender/entry-server.tsx --outDir dist-ssr",
    "prerender": "node prerender/run.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
